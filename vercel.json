{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "packages/**",
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/backend/src/index.ts"
    }
  ]
}
